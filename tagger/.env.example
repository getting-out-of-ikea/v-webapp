# Google Cloud Vision
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
VISION_TIMEOUT_MS=10000
VISION_MAX_RESULTS=30
VISION_ENABLE_OBJECTS=false
VISION_ENABLE_WEB=false

# Upload limits
MAX_IMAGE_SIZE=10485760
MAX_IMAGE_DIMENSION=1600

# Local assets
TAG_ALIAS_PATH=app/data/tag_aliases.json

# CORS (JSON list)
CORS_ALLOW_ORIGINS=["http://localhost:5173"]
