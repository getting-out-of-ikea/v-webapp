# tagger service configuration.
# Copy to `.env` (never commit it) and adjust.
# Settings are read from the working directory, so run commands from `tagger/`.

# --- Google Cloud Vision ------------------------------------------------
# Local development: path to a service-account JSON key with
# vision.images.annotate. Keep the file outside version control.
# Deployments: leave empty, the service account is attached to the runtime.
GOOGLE_APPLICATION_CREDENTIALS=./ignore/service-account.json
GOOGLE_CLOUD_PROJECT=

# --- Vision request tuning (used from M2 on) ----------------------------
VISION_TIMEOUT_MS=10000
VISION_MAX_RESULTS=30
VISION_ENABLE_OBJECTS=true
VISION_ENABLE_WEB=false

# --- HTTP layer ---------------------------------------------------------
# Maximum accepted upload, in bytes (10 MB).
MAX_IMAGE_SIZE=10485760
# Comma-separated browser origins allowed by CORS; empty disables CORS.
CORS_ALLOW_ORIGINS=http://localhost:5173

# --- Operations ---------------------------------------------------------
# How long a /health credential check is reused, in seconds.
HEALTH_CACHE_TTL_S=300
